metadata/_custom_type_script = "uid://brh5ahw4b770k"

[sub_resource type="Resource" id="Resource_at5dv"]
script = ExtResource("1_yvakc")
text = "Разберу что-нибудь дома: старый ноут, полку, велик — руки скучают"
point = "engineer"
metadata/_custom_type_script = "uid://brh5ahw4b770k"

[sub_resource type="Resource" id="Resource_jcd4p"]
script = ExtResource("1_yvakc")
text = "Почитаю, посмотрю лекцию, разберусь в теме, которая давно манит"
point = "scientist"
metadata/_custom_type_script = "uid://brh5ahw4b770k"

[sub_resource type="Resource" id="Resource_uacia"]
script = ExtResource("1_yvakc")
text = "Напишу друзьям: «А давайте что-нибудь устроим?»"
