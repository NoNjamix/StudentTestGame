[node name="Label2" type="Label" parent="MarginContainer/PanelContainer/MarginContainer/VBoxContainer" unique_id=796640168]
custom_minimum_size = Vector2(600, 0)
layout_mode = 2
size_flags_vertical = 0
text = "«Студент года» — ежегодный конкурс МГТУ им. Н.Э. Баумана, объединяющий самых активных и инициативных студентов Университета.

Конкурс даёт возможность представить свои достижения и сделать шаг к новым высотам в профессиональном и личном развитии.

Он объединяет тех, кто добивается успехов в науке, инженерии, общественной жизни, творчестве и спорте и вдохновляет других собственным примером."
label_settings = SubResource("LabelSettings_y6le1")
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

